{
  "name": "fc-filepick",
  "version": "2.0.0",
  "description": "File Picker for Command Line Applications using inquirer",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "engines": {
    "node": ">=18"
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bun optimize.js",
    "start": "nodemon demo/run.js --watch src -I",
    "test": "node test/prompt.test.mjs && node demo/test-dist.cjs",
    "demo": "node demo/demo.js",
    "docs:serve": "docsify generate docs",
    "prepublishOnly": "npm run build && npm test",
    "release": "npm publish"
  },
  "keywords": [
    "cli",
    "file",
    "folder",
    "directory",
    "file-picker",
    "filepicker",
    "filebrowser",
    "picker",
    "prompt",
    "inquirer"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agrublev/fc-filepick.git"
  },
  "homepage": "https://github.com/agrublev/fc-filepick#readme",
  "bugs": {
    "url": "https://github.com/agrublev/fc-filepick/issues"
  },
  "author": "Angel Grablev <agrublev@gmail.com>",
  "license": "ISC",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {},
  "devDependencies": {
    "@inquirer/input": "^5.1.2",
    "@inquirer/search": "^4.2.1",
    "@inquirer/testing": "^3.3.9",
    "chalk": "^5.3.0",
    "docsify-cli": "^4.4.4",
    "esbuild": "^0.23.0",
    "nodemon": "^3.1.0"
  }
}
